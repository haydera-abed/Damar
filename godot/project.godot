; ملف إعدادات Godot — افتح المجلد في Godot 4.7 واضغط F5 للعب

config_version=5

[application]

config/name="دمار: مطاردة الليل"
config/description="اسرق المتاجر والبنوك، اهرب من الشرطة، وخبّئ غنيمتك."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"


[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
LandManager="*res://scripts/autoloads/land_manager.gd"
EconomyManager="*res://scripts/autoloads/economy_manager.gd"
TravelManager="*res://scripts/autoloads/travel_manager.gd"
HeistCityManager="*res://scripts/autoloads/heist_city_manager.gd"
PrisonManager="*res://scripts/autoloads/prison_manager.gd"
MotelManager="*res://scripts/autoloads/motel_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Cairo.ttf"

