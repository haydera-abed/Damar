[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicles"
3d_physics/layer_3="characters"

[physics]

common/physics_ticks_per_second=60

[rendering]

occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=1.0

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
